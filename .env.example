# MahaSkills Environment Configuration Template
ENVIRONMENT=development

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://mahaskills_user:mahaskills_secret@localhost:5432/mahaskills
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0

# Keycloak OIDC Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=mahaskills
KEYCLOAK_CLIENT_ID=mahaskills-api
KEYCLOAK_CLIENT_SECRET=change_me_in_production

# DPDP Act 2023 Candidate Pseudonymization Secret Pepper
DPDP_TENANT_SALT=development_hmac_sha256_pepper_secret_key_32bytes!

# S3 / MinIO Object Storage
AWS_REGION=ap-south-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PLACEMENTS=mahaskills-placements
S3_BUCKET_DOSSIERS=mahaskills-dossiers

# Frontend Client Settings
VITE_API_BASE_URL=http://localhost:8000/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=mahaskills
VITE_KEYCLOAK_CLIENT_ID=mahaskills-web
