# MahaSkills Environment Configuration Template
ENVIRONMENT=development

# Database Configuration (PostgreSQL 16)
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql+asyncpg://mahaskills_user:your_secure_postgres_password_here@localhost:5432/mahaskills
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0

# Keycloak OIDC Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=mahaskills
KEYCLOAK_CLIENT_ID=mahaskills-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_AUDIENCE=mahaskills-api
KEYCLOAK_JWKS_CACHE_SECONDS=3600

# CORS Allowed Origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# DPDP Act 2023 Candidate Pseudonymization Secret Pepper
# Must be at least 32 characters. Must be generated per environment.
# Must never be reused across tiers (dev/staging/prod), because rotating it invalidates every previously issued candidate pseudonym.
DPDP_TENANT_SALT=your_secure_random_32_char_minimum_pepper_salt_here

# S3 / MinIO Object Storage
AWS_REGION=ap-south-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PLACEMENTS=mahaskills-placements
S3_BUCKET_DOSSIERS=mahaskills-dossiers

# Frontend Client Settings
VITE_API_BASE_URL=http://localhost:8000/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=mahaskills
VITE_KEYCLOAK_CLIENT_ID=mahaskills-web
